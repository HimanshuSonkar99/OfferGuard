# OfferGuard environment configuration (copy to .env if needed)
# These values are optional. OfferGuard works fully offline without any key.

# Path to a custom SQLite database file (default: data/offerguard.db)
# OFFERGUARD_DB=data/offerguard.db

# Enable or disable external verification lookups (RDAP domain registration checks)
# OFFERGUARD_EXTERNAL_CHECKS=1

# Optional: path to the Tesseract executable if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional future AI layer. Leave empty to use the deterministic rule engine only.
# AI_API_KEY=
# AI_API_URL=
